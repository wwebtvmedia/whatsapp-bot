# Database Configuration
MONGO_URL=mongodb://mongo:27017/whatsapp-bot
CHROMA_URL=http://chromadb:8000
EMBEDDING_URL=http://embeddings:8001/embed
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# LLM Configuration
LLM_URL=http://llamacpp:8080/v1/chat/completions
LLM_MODEL=model
LLM_TYPE=openai

# Auto-reply is no longer controlled here: it is disabled for every contact by
# default and toggled per contact from the web panel (stored in MongoDB).

# Remote Ollama server used by install.sh to pick the LLM backend
# (set your server URL, e.g. http://192.168.1.x:11434 — leave empty to force
# the local llama.cpp fallback)
OLLAMA_URL=
OLLAMA_MODEL=bestmodel:latest

# Paths
WHATSAPP_AUTH_PATH=./auth
DOWNLOADS_PATH=./downloads
...

# Server Configuration
SERVER_PORT=3000
API_TOKEN=YOUR_SECRET_TOKEN_HERE

# Memory / GraphRAG tuning (optional)
DIGEST_EMBED_EVERY=5
CONTEXT_MAX_MESSAGES=6

# Document indexing: received PDFs / docx / text files are extracted and made
# searchable through /api/query-memory and the auto-reply context
MEDIA_INDEXING=true

# OCR for received images (jpg/png/webp) via tesseract — enabled by default;
# language data (~15 MB) is downloaded on first use, so the container needs
# internet access once. Set MEDIA_OCR_ENABLED=false to disable.
MEDIA_OCR_ENABLED=true
MEDIA_OCR_LANG=eng+fra
# Scanned PDFs (image pages, e.g. magazines) are rasterized with pdftoppm then
# OCR'd page by page with the same engine. These bound the work per document.
MEDIA_PDF_OCR_PAGES=30
MEDIA_PDF_OCR_DPI=150

# Mail ingestion (optional, opt-in) — inbound emails land in the same memory
# as WhatsApp messages; outbound mail is exposed via POST /api/send-email
MAIL_ENABLED=false
MAIL_PORT=587
MAIL_IMAP_PORT=993

# Fill these in when MAIL_ENABLED=true (SMTP for sending, IMAP for ingestion)
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_IMAP_HOST=
