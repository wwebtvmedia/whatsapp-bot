# Database Configuration
MONGO_URL=mongodb://mongo:27017/whatsapp-bot
CHROMA_URL=http://chromadb:8000
EMBEDDING_URL=http://embeddings:8001/embed
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# LLM Configuration
LLM_URL=http://llamacpp:8080/v1/chat/completions
LLM_MODEL=model
LLM_TYPE=openai
AUTO_REPLY=true

# Remote Ollama server used by install.sh to pick the LLM backend
# (set your server URL, e.g. http://192.168.1.x:11434 — leave empty to force
# the local llama.cpp fallback)
OLLAMA_URL=
OLLAMA_MODEL=bestmodel:latest

# Paths
WHATSAPP_AUTH_PATH=./auth
DOWNLOADS_PATH=./downloads
...

# Server Configuration
SERVER_PORT=3000
API_TOKEN=YOUR_SECRET_TOKEN_HERE

# Memory / GraphRAG tuning (optional)
DIGEST_EMBED_EVERY=5
CONTEXT_MAX_MESSAGES=6
